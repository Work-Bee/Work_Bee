# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Use either local Mongo or Atlas; only one should be uncommented
# MONGO_URI=mongodb://localhost:27017/work_bee
# MongoDB Atlas URI (example - replace with real credentials/cluster/appName)
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/work_bee?retryWrites=true&w=majority&appName=<appName>

# JWT Configuration
JWT_SECRET=change-me-in-production
JWT_EXPIRE=30d

# Google OAuth Configuration (required for "Continue with Google" feature)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
FRONTEND_BASE_URL=http://localhost:3333

# Optional seeds/admin bootstrap
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
# ADMIN_PHONE=
# ADMIN_LOCATION=
# SEED_DEMO_PASSWORD=
# ADMIN_SEED_PASSWORD=
# ADMIN_SEED_NAME=
# ADMIN_SEED_EMAIL=
# ADMIN_SEED_PHONE=
# ADMIN_SEED_LOCATION=
